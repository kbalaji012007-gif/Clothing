# Backend Configuration
PORT=8001
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# Firebase Configuration
# Option 1: Path to serviceAccountKey.json (default: backend/serviceAccountKey.json)
SERVICE_ACCOUNT_KEY_PATH=backend/serviceAccountKey.json

# Option 2: Full JSON string for deployment platforms like Render / Railway / Fly.io
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", "project_id": "...", ...}

# Option 3: Firebase Project ID (for Application Default Credentials)
# FIREBASE_PROJECT_ID=your-project-id
