rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Products: Publicly readable by all shoppers, writable only by admins
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Carts: Publicly readable and writable by matching session
    match /carts/{sessionId} {
      allow read, write: if true;
    }

    // Orders: Anyone can create an order, users can read their own orders
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null;
    }

    // Users: Accounts readable/writable by the owner
    match /users/{email} {
      allow read, write: if true;
    }
  }
}
