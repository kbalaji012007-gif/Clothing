{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClothingAgencyFirestoreDatabase",
  "description": "Firestore collection schemas for Clothing Agency E-Commerce",
  "collections": {
    "products": {
      "type": "object",
      "required": ["id", "title", "category", "price", "numericPrice", "sizes"],
      "properties": {
        "id": { "type": "string", "description": "Unique product slug (e.g. luka-5, rack-blazer-navy-1)" },
        "title": { "type": "string", "description": "Display title of the product" },
        "name": { "type": "string", "description": "Short name variant" },
        "subtitle": { "type": "string", "description": "Editorial tagline or material spec" },
        "category": { "type": "string", "enum": ["sneakers", "rack", "runway"] },
        "price": { "type": "string", "description": "Formatted price (e.g. $149.00)" },
        "numericPrice": { "type": "number", "description": "Raw numeric price for calculations" },
        "image": { "type": "string", "description": "Primary cutout or product asset URL" },
        "frontImage": { "type": "string", "description": "Front-facing garment cutout" },
        "sideImage": { "type": "string", "description": "Side-profile resting garment cutout" },
        "tag": { "type": "string", "description": "Price tag string (e.g. $199)" },
        "desc": { "type": "string", "description": "Detailed editorial description" },
        "sizes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Available size inventory (e.g. ['40', '41', '42'] or ['S', 'M', 'L'])"
        },
        "in_stock": { "type": "boolean", "default": true }
      }
    },
    "carts": {
      "type": "object",
      "required": ["session_id", "items", "subtotal"],
      "properties": {
        "session_id": { "type": "string", "description": "Anonymous session ID or member user_id" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_id", "product_id", "title", "size", "quantity", "price"],
            "properties": {
              "item_id": { "type": "string" },
              "product_id": { "type": "string" },
              "title": { "type": "string" },
              "size": { "type": "string" },
              "quantity": { "type": "integer", "minimum": 1 },
              "price": { "type": "number" },
              "image": { "type": "string" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "total_items": { "type": "integer" }
      }
    },
    "orders": {
      "type": "object",
      "required": ["id", "customer_name", "customer_email", "items", "total", "status", "created_at"],
      "properties": {
        "id": { "type": "string", "description": "Unique Order ID (e.g. ORD-XXXXXX)" },
        "customer_id": { "type": "string" },
        "customer_name": { "type": "string" },
        "customer_email": { "type": "string", "format": "email" },
        "customer_phone": { "type": "string" },
        "shipping_address": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["product_id", "title", "size", "quantity", "price"],
            "properties": {
              "product_id": { "type": "string" },
              "title": { "type": "string" },
              "size": { "type": "string" },
              "color": { "type": "string" },
              "quantity": { "type": "integer" },
              "price": { "type": "number" },
              "image": { "type": "string" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "tax": { "type": "number", "default": 0 },
        "delivery_charge": { "type": "number", "default": 0 },
        "discount": { "type": "number", "default": 0 },
        "total": { "type": "number" },
        "payment_method": { "type": "string" },
        "payment_reference": { "type": "string" },
        "payment_status": { "type": "string", "enum": ["PENDING", "UNDER_REVIEW", "VERIFIED", "FAILED", "REFUNDED"] },
        "status": { "type": "string", "enum": ["PAYMENT_PENDING", "PAYMENT_UNDER_REVIEW", "CONFIRMED", "PROCESSING", "PACKED", "SHIPPED", "OUT_FOR_DELIVERY", "DELIVERED", "CANCELLED", "REFUND_REQUESTED", "REFUNDED"] },
        "tracking_number": { "type": "string" },
        "cancellation_reason": { "type": "string" },
        "refund_reason": { "type": "string" },
        "admin_notes": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "users": {
      "type": "object",
      "required": ["user_id", "name", "email", "password_hash", "role", "created_at"],
      "properties": {
        "user_id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "password_hash": { "type": "string" },
        "role": { "type": "string", "enum": ["CUSTOMER", "ADMIN"], "default": "CUSTOMER" },
        "phone": { "type": "string" },
        "addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "tag": { "type": "string" },
              "line1": { "type": "string" },
              "city": { "type": "string" },
              "postal_code": { "type": "string" },
              "country": { "type": "string" },
              "is_default": { "type": "boolean" }
            }
          }
        },
        "wishlist": {
          "type": "array",
          "items": { "type": "string" }
        },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "payments": {
      "type": "object",
      "required": ["payment_id", "order_id", "amount", "currency", "payment_method", "status", "created_at"],
      "properties": {
        "payment_id": { "type": "string" },
        "order_id": { "type": "string" },
        "amount": { "type": "number" },
        "currency": { "type": "string", "default": "INR" },
        "amount_usd": { "type": "number" },
        "payment_method": { "type": "string" },
        "utr_reference": { "type": "string" },
        "status": { "type": "string", "enum": ["PENDING", "UNDER_REVIEW", "VERIFIED", "FAILED", "REFUNDED"] },
        "verified_by": { "type": "string" },
        "verified_at": { "type": "string", "format": "date-time" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "admin_activity_logs": {
      "type": "object",
      "required": ["log_id", "admin_email", "action", "timestamp"],
      "properties": {
        "log_id": { "type": "string" },
        "admin_email": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
